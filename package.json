{
  "name": "embers-echoes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/elyseeJuly/embers-echoes.git"
  },
  "author": "Michael Townsend <michael@doublespeakgames.com>",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "deploy:cf": "CF_PAGES=1 npm run build && wrangler deploy",
    "start": "node dev-server.js",
    "update_pot": "pybabel extract -F lang/babel.cfg -c \"TRANSLATORS\" script -o lang/adarkroom.pot",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:scenario": "vitest run test/scenarios test/regression",
    "test:simulation": "vitest run test/simulation/suites",
    "test:sim:smoke": "vitest run test/simulation/suites/smoke.sim.test.js",
    "test:sim:regression": "vitest run test/simulation/suites/regression.sim.test.js",
    "test:sim:balance": "SIM_MODE=balance vitest run test/simulation/suites/balance.sim.test.js",
    "test:sim:soak": "SIM_MODE=soak vitest run test/simulation/suites/soak.sim.test.js",
    "test:sim:replay": "vitest run test/simulation/suites/replay.sim.test.js",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:ci:pr": "npm run test:coverage && npm run test:sim:smoke && npm run test:sim:regression && npm run build && npm run test:e2e:smoke"
  },
  "dependencies": {
    "express": "^4.17.1"
  },
  "description": "*“在热寂的绝对零度中，寻找最后一丝理智的火花。”*",
  "main": "dev-server.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/elyseeJuly/embers-echoes/issues"
  },
  "homepage": "https://github.com/elyseeJuly/embers-echoes#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^2.1.9",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^2.1.9",
    "wrangler": "^4.10.0"
  },
  "packageManager": "npm"
}
